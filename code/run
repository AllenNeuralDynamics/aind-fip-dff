#!/usr/bin/env bash
set -euo pipefail

# Master script for the capsule. App Panel parameters arrive positionally, in
# the order they are defined in the panel:
#   $1 dF/F methods (space-separated)   $4 noise cutoff frequency [Hz]
#   $2 baseline percentile              $5 run serially (true/false)
#   $3 motion cutoff frequency [Hz]     $6 skip QC plots (true/false)
# Paths keep run_capsule.py's defaults and are deliberately not exposed.

dff_methods="${1:-poly exp bright-v2}"
b_percentile="${2:-0.7}"
cutoff_freq_motion="${3:-0.05}"
cutoff_freq_noise="${4:-3}"
serial="${5:-false}"
no_qc="${6:-false}"

is_true() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

args=(
  --b_percentile "$b_percentile"
  --cutoff_freq_motion "$cutoff_freq_motion"
  --cutoff_freq_noise "$cutoff_freq_noise"
)

# space-separated list -> argparse nargs="+"
read -r -a methods <<< "$dff_methods"
if [[ ${#methods[@]} -gt 0 ]]; then
  args+=(--dff_methods "${methods[@]}")
fi

if is_true "$serial"; then
  args+=(--serial)
fi

if is_true "$no_qc"; then
  args+=(--no_qc)
fi

python -u run_capsule.py "${args[@]}"
